{
    "name": "unopim/unopim",
    "type": "project",
    "description": "UnoPim Laravel PIM",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "astrotomic/laravel-translatable": "^11.17",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "diesite/monitor-client": "^1.1",
        "elasticsearch/elasticsearch": "^8.10",
        "enshrined/svg-sanitize": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^4.3",
        "kalnoy/nestedset": "^7.0",
        "khaled.alshamaa/ar-php": "^7.0",
        "konekt/concord": "^1.18",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.7",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maatwebsite/excel": "^4.0",
        "openai-php/laravel": "^0.21",
        "owen-it/laravel-auditing": "^14.0.5",
        "predis/predis": "^3.0",
        "prettus/l5-repository": "^4.0",
        "pusher/pusher-php-server": "^7.0",
        "sentry/sentry-laravel": "^4.27",
        "shetabit/visitor": "^4.5.6",
        "spatie/image": "^3.8",
        "symfony/intl": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "fruitcake/laravel-debugbar": "^4.4",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Webkul\\Admin\\": "packages/Webkul/Admin/src",
            "Webkul\\Attribute\\": "packages/Webkul/Attribute/src",
            "Webkul\\Category\\": "packages/Webkul/Category/src",
            "Webkul\\Core\\": "packages/Webkul/Core/src",
            "Webkul\\DataGrid\\": "packages/Webkul/DataGrid/src",
            "Webkul\\DataTransfer\\": "packages/Webkul/DataTransfer/src",
            "Webkul\\DebugBar\\": "packages/Webkul/DebugBar/src",
            "Webkul\\HistoryControl\\": "packages/Webkul/HistoryControl/src",
            "Webkul\\Installer\\": "packages/Webkul/Installer/src",
            "Webkul\\Inventory\\": "packages/Webkul/Inventory/src",
            "Webkul\\MagicAI\\": "packages/Webkul/MagicAI/src",
            "Webkul\\Notification\\": "packages/Webkul/Notification/src",
            "Webkul\\Product\\": "packages/Webkul/Product/src",
            "Webkul\\Theme\\": "packages/Webkul/Theme/src",
            "Webkul\\User\\": "packages/Webkul/User/src",
            "Webkul\\AdminApi\\": "packages/Webkul/AdminApi/src",
            "Webkul\\WooCommerce\\": "packages/Webkul/WooCommerce/src",
            "Webkul\\DAM\\": "packages/Webkul/DAM/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Webkul\\Admin\\Tests\\": "packages/Webkul/Admin/tests",
            "Webkul\\Core\\Tests\\": "packages/Webkul/Core/tests",
            "Webkul\\DataGrid\\Tests\\": "packages/Webkul/DataGrid/tests",
            "Webkul\\User\\Tests\\": "packages/Webkul/User/tests",
            "Webkul\\AdminApi\\Tests\\": "packages/Webkul/AdminApi/tests",
            "Webkul\\Installer\\Tests\\": "packages/Webkul/Installer/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "shetabit/visitor"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "diesite-satis": {
            "type": "composer",
            "url": "https://satis-user:7cA3bjTyWnGKT9@satis.diesite.nl/"
        }
    }
}
